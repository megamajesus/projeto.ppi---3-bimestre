<article class="cartao">
  <div class="cartao__topo">
    <span class="categoria">{{categoria}}</span>
    <span class="identificador">#{{id}}</span>
  </div>
  <h2>{{titulo}}</h2>
  <p>{{conteudo}}</p>
  <footer class="cartao__rodape">
    <span>{{autor}}</span>
    <a href="/publicacoes/{{id}}">Ler publicação</a>
  </footer>
</article>
